# Example environment variables — do NOT store secrets here
# Copy to properties.env locally and fill in real values.

# API keys
OPENAI_API_KEY=your_openai_api_key_here
OTHER_SERVICE_API_KEY=your_other_service_key_here

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Misc
SECRET_KEY=your_secret_key_here
LOG_LEVEL=info
